{
  "components" : {
    "schemas" : {
      "ClinicRequest" : {
        "properties" : {
          "name" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "phone" : {
            "maxLength" : 40,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [
          "name"
        ],
        "type" : "object"
      },
      "CreatedClinic" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "CreatedStaff" : {
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "OnboardOrganizationRequest" : {
        "properties" : {
          "clinics" : {
            "items" : {
              "$ref" : "#/components/schemas/ClinicRequest"
            },
            "minItems" : 1,
            "type" : "array"
          },
          "name" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "plan" : {
            "minLength" : 1,
            "type" : "string"
          },
          "staff" : {
            "items" : {
              "$ref" : "#/components/schemas/StaffRequest"
            },
            "minItems" : 1,
            "type" : "array"
          }
        },
        "required" : [
          "clinics",
          "name",
          "plan",
          "staff"
        ],
        "type" : "object"
      },
      "OnboardOrganizationResponse" : {
        "properties" : {
          "clinics" : {
            "items" : {
              "$ref" : "#/components/schemas/CreatedClinic"
            },
            "type" : "array"
          },
          "organizationId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "staff" : {
            "items" : {
              "$ref" : "#/components/schemas/CreatedStaff"
            },
            "type" : "array"
          },
          "subscriptionId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Problem" : {
        "additionalProperties" : true,
        "description" : "RFC 9457 problem detail. Every failure on every route answers in this shape; 'code' is the member to branch on, and members beyond the ones declared here carry the facts a particular code needs.",
        "properties" : {
          "code" : {
            "example" : "EPM-ORG-006",
            "pattern" : "^EPM-[A-Z]{3}-[0-9]{3}$",
            "type" : "string"
          },
          "status" : {
            "example" : 422,
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "example" : "Seat limit exceeded",
            "type" : "string"
          },
          "traceId" : {
            "example" : "00-1a2b3c-4d5e6f-01",
            "type" : "string"
          },
          "type" : {
            "example" : "https://errors.example.com/problems/seat-limit-exceeded",
            "type" : "string"
          }
        },
        "required" : [
          "code",
          "status",
          "title",
          "traceId",
          "type"
        ],
        "type" : "object"
      },
      "StaffRequest" : {
        "properties" : {
          "clinics" : {
            "items" : {
              "format" : "int32",
              "minimum" : 0,
              "type" : "integer"
            },
            "minItems" : 1,
            "type" : "array"
          },
          "email" : {
            "format" : "email",
            "maxLength" : 255,
            "minLength" : 0,
            "type" : "string"
          },
          "fullName" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "roles" : {
            "items" : {
              "enum" : [
                "DOCTOR",
                "RECEPTIONIST",
                "ORG_ADMIN"
              ],
              "type" : "string"
            },
            "minItems" : 1,
            "type" : "array",
            "uniqueItems" : true
          },
          "specialtyCode" : {
            "maxLength" : 40,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [
          "clinics",
          "email",
          "fullName",
          "roles"
        ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "Generated from the controllers, never written by hand (LLD §11). Every failure answers application/problem+json carrying a stable code (LLD §7).",
    "title" : "EPM platform API",
    "version" : "0.1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/platform/organizations" : {
      "post" : {
        "description" : "Creates a practice, its branches and its staff in one transaction (LLD-ORGANIZATION.md §2.1). Every id the call generated comes back, so nothing needs re-fetching. Branches and staff are returned in the order they were sent — that order is the whole of how a caller pairs a returned id with what it asked for.",
        "operationId" : "onboardOrganization",
        "parameters" : [
          {
            "description" : "The caller's retry key, one per user action. Generated when the form is submitted and reused on every retry of that submission — a new key on a retry creates a second practice.",
            "in" : "header",
            "name" : "Idempotency-Key",
            "required" : true,
            "schema" : {
              "minLength" : 1,
              "type" : "string"
            }
          }
        ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OnboardOrganizationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OnboardOrganizationResponse"
                }
              }
            },
            "description" : "This Idempotency-Key had already onboarded a practice. The body is identical to the 201, so a client that retried after a timeout needs no second code path."
          },
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/OnboardOrganizationResponse"
                }
              }
            },
            "description" : "Created. The first call carrying this Idempotency-Key."
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "The request could not be understood: malformed body, unknown field, unknown role, missing Idempotency-Key, or a branch position no branch in the request occupies."
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Two branches in the request share a name, or two staff share an email."
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Understood, but refused: the plan does not exist, a speciality code does not exist, or the staff outnumber the plan's seats."
          }
        },
        "summary" : "Onboard a practice",
        "tags" : [
          "Platform onboarding"
        ]
      }
    }
  },
  "servers" : [
    {
      "description" : "Wherever this document was served from",
      "url" : "/"
    }
  ],
  "tags" : [
    {
      "description" : "Routes a platform administrator calls. The caller belongs to no practice, so nothing here is scoped to one (LLD §3).",
      "name" : "Platform onboarding"
    }
  ]
}

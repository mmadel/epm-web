# Copy this file to `.env` at the workspace root and fill in the value.
# `.env` is git-ignored; never commit real environment values.
#
# EPM_API_BASE_URL
#   Absolute base URL of the EPM API, read at build time by
#   scripts/generate-environment.mjs and provided to both applications through the
#   API_BASE_URL injection token from the `core` library.
#
#   It must be an absolute http:/https: URL including protocol and host. A relative
#   path such as a same-origin `/…` prefix is rejected: the staff console and the
#   patient app (which ships as a Capacitor bundle served from `capacitor://`) are
#   deployed separately from the API and are never same-origin with it.
#
#   A trailing slash is removed during generation.
#
#   `npm run build`, `npm start` and `npm test` all fail before Angular starts when
#   this variable is missing or invalid.

EPM_API_BASE_URL=https://api.example.com
